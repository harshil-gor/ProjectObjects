{
  "manifest_version": 3,
  "name": "SE3 Robo Projector",
  "version": "1.1.0",
  "description": "External Magcubic HY450 table projector overlay for the SE3 station console (Firefox + Chrome).",
  "browser_specific_settings": {
    "gecko": {
      "id": "se3-robo-projector@projectobjects.local",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8765/*",
        "http://localhost:3000/*"
      ],
      "js": ["inject-page.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://127.0.0.1:8765/*",
        "http://localhost:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": [
        "http://127.0.0.1:8765/*",
        "http://localhost:3000/*"
      ]
    }
  ]
}
